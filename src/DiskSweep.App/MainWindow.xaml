<Window x:Class="DiskSweep.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiskSweep.App"
        xmlns:vm="clr-namespace:DiskSweep.App.ViewModels"
        Title="DiskSweep" Width="1320" Height="840" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource TextFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="Vis" />
        <local:BoolToVisibilityConverter x:Key="NotVis" Invert="True" />
        <local:RiskToBrushConverter x:Key="RiskBrush" />

        <!-- A coloured pill for Safe / Review / Risky -->
        <DataTemplate x:Key="RiskPill">
            <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{Binding Risk, Converter={StaticResource RiskBrush}, ConverterParameter=bg}">
                <TextBlock Text="{Binding RiskText}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ResultTabViewModel}">
            <Grid>
                <Grid.Resources>
                    <local:BindingProxy x:Key="Proxy" Data="{Binding}" />
                </Grid.Resources>

                <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource MutedBrush}" Margin="4,24"
                           TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" />

                <DataGrid ItemsSource="{Binding Items}"
                          Visibility="{Binding IsEmpty, Converter={StaticResource NotVis}}"
                          SelectedItem="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                              ToolTip="{Binding SelectionNote}" ToolTipService.ShowOnDisabled="True"
                                              AutomationProperties.Name="Select item" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Risk" Width="104" SortMemberPath="Risk" CellTemplate="{StaticResource RiskPill}" />

                        <DataGridTemplateColumn Header="Name" Width="2*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Location" Width="3*" SortMemberPath="Location">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Location}" ToolTip="{Binding Path}" Style="{StaticResource CellText}"
                                               Foreground="{StaticResource MutedBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Size" Width="90" Binding="{Binding SizeText, Mode=OneWay}" SortMemberPath="SizeSort"
                                            ElementStyle="{StaticResource NumberCell}"
                                            Visibility="{Binding Data.ShowSize, Source={StaticResource Proxy}, Converter={StaticResource Vis}}" />
                        <DataGridTextColumn Header="Modified" Width="96" Binding="{Binding ModifiedText, Mode=OneWay}" SortMemberPath="ModifiedSort"
                                            ElementStyle="{StaticResource NumberCell}"
                                            Visibility="{Binding Data.ShowModified, Source={StaticResource Proxy}, Converter={StaticResource Vis}}" />
                        <DataGridTextColumn Header="Installed" Width="96" Binding="{Binding InstalledText, Mode=OneWay}"
                                            ElementStyle="{StaticResource NumberCell}"
                                            Visibility="{Binding Data.ShowLastUsed, Source={StaticResource Proxy}, Converter={StaticResource Vis}}" />
                        <DataGridTextColumn Header="Last used" Width="110" Binding="{Binding LastUsedText, Mode=OneWay}" SortMemberPath="LastUsedSort"
                                            ElementStyle="{StaticResource NumberCell}"
                                            Visibility="{Binding Data.ShowLastUsed, Source={StaticResource Proxy}, Converter={StaticResource Vis}}" />
                        <DataGridTextColumn Header="Date from" Width="1.6*" Binding="{Binding LastUsedSource, Mode=OneWay}"
                                            ElementStyle="{StaticResource MutedCellTextTip}"
                                            Visibility="{Binding Data.ShowLastUsed, Source={StaticResource Proxy}, Converter={StaticResource Vis}}" />
                        <DataGridTextColumn Header="Confidence" Width="92" Binding="{Binding ConfidenceText, Mode=OneWay}" SortMemberPath="ConfidenceSort"
                                            ElementStyle="{StaticResource NumberCell}"
                                            Visibility="{Binding Data.ShowConfidence, Source={StaticResource Proxy}, Converter={StaticResource Vis}}" />
                        <DataGridTextColumn Header="Why it's listed" Width="3*" Binding="{Binding Reason, Mode=OneWay}"
                                            ElementStyle="{StaticResource CellTextTip}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SkippedTabViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Small}" Margin="2,0,0,8" />
                <DataGrid ItemsSource="{Binding Items}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Path" Width="3*" Binding="{Binding Path, Mode=OneWay}" ElementStyle="{StaticResource CellTextTip}" />
                        <DataGridTextColumn Header="Why it was skipped" Width="2*" Binding="{Binding Reason, Mode=OneWay}"
                                            ElementStyle="{StaticResource MutedCellTextTip}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DiskSweep" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Finds clutter that's safe to remove. This version only reports; nothing on your disk is changed."
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="16,0,0,2" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="10" Padding="10,3" Background="{StaticResource CanvasBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AccountText}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </Border>
                    <Button Content="Restart as administrator" Style="{StaticResource QuietButton}" Margin="8,0,0,0"
                            Command="{Binding RestartAsAdministratorCommand}"
                            ToolTip="Lets DiskSweep read Windows\Temp, Prefetch, every scheduled task and other users' folders."
                            Visibility="{Binding IsAdmin, Converter={StaticResource NotVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: drive, categories, thresholds; the Scan button stays visible at the bottom -->
            <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Bottom" Padding="24,12,16,20" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                <Button Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}"
                        Padding="14,10" FontSize="14" HorizontalAlignment="Stretch" />
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEditOptions}">
                <StackPanel Margin="24,20,16,24">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource QuietButton}" Command="{Binding RefreshDrivesCommand}" />
                        <TextBlock Text="Drive" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                             ItemContainerStyle="{StaticResource DriveListItem}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Drives">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Letter}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                                               VerticalAlignment="Top" Margin="0,-2,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Small}" />
                                        <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,8,0,4" />
                                        <TextBlock Text="{Binding SpaceText}" Style="{StaticResource Small}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Look for" Style="{StaticResource SectionTitle}" Margin="0,16,0,10" />
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,0,12" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Thresholds" Style="{StaticResource SectionTitle}" Margin="0,8,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Program unused after" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding UnusedDays}" Margin="0,0,0,8" AutomationProperties.Name="Unused program days" />
                        <TextBlock Grid.Column="2" Text="days" Margin="8,0,0,8" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />

                        <TextBlock Grid.Row="1" Text="Large file from" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LargeFileMb}" Margin="0,0,0,8" AutomationProperties.Name="Large file megabytes" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="MB" Margin="8,0,0,8" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />

                        <TextBlock Grid.Row="2" Text="Old download after" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OldFileDays}" Margin="0,0,0,8" AutomationProperties.Name="Old download days" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="days" Margin="8,0,0,8" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            </DockPanel>

            <!-- Right: idle / scanning / results -->
            <Border Grid.Column="1" Margin="0,20,24,20" Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource RuleBrush}" BorderThickness="1">
                <Grid>
                    <!-- Idle -->
                    <StackPanel MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32"
                                Visibility="{Binding IsIdle, Converter={StaticResource Vis}}">
                        <TextBlock Text="Pick a drive and what to look for, then scan." Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24" LineHeight="20"
                                   Text="Scanning only reads your disk. Every item comes with the reason it was listed and one of three risk levels:" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Left" Background="{StaticResource SafeTintBrush}" Margin="0,0,0,12">
                                <TextBlock Text="Safe" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SafeBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Margin="0,1,0,12"
                                       Text="Ticked for you. Old temp files and empty folders in your own folders." />
                            <Border Grid.Row="1" CornerRadius="10" Padding="9,2" HorizontalAlignment="Left" Background="{StaticResource ReviewTintBrush}" Margin="0,0,0,12">
                                <TextBlock Text="Review" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ReviewBrush}" />
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,1,0,12"
                                       Text="Probably clutter, but check it first. Never ticked for you." />
                            <Border Grid.Row="2" CornerRadius="10" Padding="9,2" HorizontalAlignment="Left" Background="{StaticResource RiskyTintBrush}">
                                <TextBlock Text="Risky" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RiskyBrush}" />
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,1,0,0"
                                       Text="Might still be needed, or couldn't be fully checked. Leave it unless you're sure." />
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Small}" Margin="0,24,0,0"
                                   Text="Windows, Program Files roots, installed programs, user profile roots, cloud-synced folders and links are never offered." />
                    </StackPanel>

                    <!-- Scanning -->
                    <StackPanel MaxWidth="640" VerticalAlignment="Center" Margin="40"
                                Visibility="{Binding IsScanning, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding PhaseText}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                        <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding ProgressPercent, Mode=OneWay}" Margin="0,16,0,8" Height="8"
                                     AutomationProperties.Name="Scan progress" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Foreground="{StaticResource MutedBrush}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{Binding FoundText}" Typography.NumeralAlignment="Tabular" />
                        </DockPanel>
                        <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Small}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Margin="0,6,0,24" ToolTip="{Binding CurrentPath}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
                            <TextBlock Text="Read-only. Nothing is moved or deleted." Style="{StaticResource Small}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Results -->
                    <Grid Margin="20,18,20,16" Visibility="{Binding HasResults, Converter={StaticResource Vis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding SummaryText}" FontSize="14" TextWrapping="Wrap" />

                        <!-- How the found space splits across risk levels -->
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <Grid Height="12">
                                <!-- One column per risk level, in RiskLevel order (Safe, Review, Risky). -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding RiskBuckets[0].Width}" />
                                    <ColumnDefinition Width="{Binding RiskBuckets[1].Width}" />
                                    <ColumnDefinition Width="{Binding RiskBuckets[2].Width}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource SafeBrush}" CornerRadius="3" Margin="0,0,2,0" />
                                <Border Grid.Column="1" Background="{StaticResource ReviewBrush}" CornerRadius="3" Margin="0,0,2,0" />
                                <Border Grid.Column="2" Background="{StaticResource RiskyBrush}" CornerRadius="3" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RiskBuckets}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                                     Fill="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                                            <TextBlock Text="{Binding Legend}" Style="{StaticResource Small}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Notes about what couldn't be checked -->
                        <Border Grid.Row="2" Background="{StaticResource ReviewTintBrush}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
                                Visibility="{Binding Notes.Count, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Restart as administrator" Style="{StaticResource QuietButton}"
                                        VerticalAlignment="Top" Command="{Binding RestartAsAdministratorCommand}"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource NotVis}}" />
                                <ItemsControl ItemsSource="{Binding Notes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" FontSize="12" Foreground="{StaticResource InkBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <TabControl Grid.Row="3" Margin="0,12,0,0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Header}" />
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                        </TabControl>

                        <!-- Details of the selected row -->
                        <Border Grid.Row="4" Margin="0,12,0,0" Padding="14,12" CornerRadius="8" Background="{StaticResource CanvasBrush}"
                                MaxHeight="200" Visibility="{Binding HasSelectedItem, Converter={StaticResource Vis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid DataContext="{Binding SelectedItem}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RiskPill}" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBox Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 Padding="0" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                 AutomationProperties.Name="Full path" />
                                        <TextBlock Text="{Binding Reason}" FontWeight="SemiBold" Margin="0,8,0,2" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Evidence}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="4" Height="4" Fill="{StaticResource MutedBrush}" HorizontalAlignment="Left"
                                                                 VerticalAlignment="Top" Margin="3,7,0,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding PublisherText}" Style="{StaticResource Small}" Margin="0,8,0,0"
                                                   Visibility="{Binding PublisherText, Converter={StaticResource Vis}}" />
                                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Small}"
                                                   Visibility="{Binding UninstallCommand, Converter={StaticResource Vis}}">
                                            <Run Text="Uninstaller registered by the program:" />
                                            <Run Text="{Binding UninstallCommand, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectionNote}" Style="{StaticResource Small}" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Show in Explorer" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top"
                                            Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding IsFileSystemItem, Converter={StaticResource Vis}}" Margin="16,0,0,0" />
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0" Padding="24,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Open log" Style="{StaticResource QuietButton}" Command="{Binding OpenLogCommand}" Margin="0,0,8,0" />
                    <Button Content="New scan" Style="{StaticResource SecondaryButton}" Command="{Binding NewScanCommand}" Margin="0,0,8,0"
                            Visibility="{Binding HasResults, Converter={StaticResource Vis}}" />
                    <Button Content="Clean selected…" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                            ToolTip="Moving items to the Recycle Bin or quarantine arrives in phase 2. This version only reports."
                            ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
                <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                           Visibility="{Binding HasResults, Converter={StaticResource Vis}}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
